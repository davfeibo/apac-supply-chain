function getCategoryStyle(categoryName) {
  if (!categoryName) return "bg-slate-100 text-slate-700 border-slate-300/40";
  if (categoryColorMap[categoryName]) {
    return categoryColorMap[categoryName];
  }
  
  // Find a color index that hasn't been used yet
  let chosenIdx = 0;
  for (let i = 0; i < categoryColors.length; i++) {
    if (!usedColorIndices.has(i)) {
      chosenIdx = i;
      break;
    }
  }
  // If all are used, just cycle based on count
  if (usedColorIndices.size >= categoryColors.length) {
    chosenIdx = Object.keys(categoryColorMap).length % categoryColors.length;
  }
  
  usedColorIndices.add(chosenIdx);
  categoryColorMap[categoryName] = categoryColors[chosenIdx];
  return categoryColorMap[categoryName];
}

