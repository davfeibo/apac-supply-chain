 // Coordinate-based timeline projection (comprehensive edge-to-edge tracking)
 function getTimelineFromX(clientX) {
   const ws = workspaces.find(w => w.id === activeWorkspaceId);
   if (!ws) return null;
   
   let closestTime = null;
   let minDistance = Infinity;
   
   ws.timelines.forEach(time => {
     const header = document.getElementById(`qhead-${time}`);
     if (header) {
       const rect = header.getBoundingClientRect();
       const center = rect.left + rect.width / 2;
       const dist = Math.abs(clientX - center);
       
       if (clientX >= rect.left && clientX <= rect.right) {
         closestTime = time;
         minDistance = 0; // Exact match found
       } else if (dist < minDistance) {
         minDistance = dist;
         closestTime = time;
       }
     }
   });
   return closestTime;
 }

 // Drag stretching extending system (Resizer Engine with complete dual contracting)
 window.startCardResize = function(e, projectId, edge, tower) {
 e.stopPropagation();
 e.preventDefault();
 
 const ws = workspaces.find(w => w.id === activeWorkspaceId);
 if (!ws) return;
 const proj = ws.projects.find(p => p.id === projectId);
 if (!proj) return;
 
 resizeState.projectId = projectId;
 resizeState.type = edge;
 resizeState.currentTower = tower;
 resizeState.initialTimeline = proj.timeline;
 resizeState.initialTimelineEnd = proj.timelineEnd || proj.timeline;
 
 // Disable page selection while resizing
 document.body.style.userSelect = 'none';
 document.body.style.cursor = 'ew-resize';
 
 // Temporarily disable pointer events on all cards so the X coordinate projection fallthrough works perfectly
 const cards = document.querySelectorAll('.liquid-glass-card');
 cards.forEach(card => {
   if (card.id !== `card-${projectId}`) {
     card.style.pointerEvents = 'none';
   }
 });
 
 document.addEventListener('mousemove', handleCardResizeMove);
 document.addEventListener('mouseup', handleCardResizeMouseUp);
 };

 function handleCardResizeMove(e) {
 if (!resizeState.projectId) return;
 
 const targetTimeline = getTimelineFromX(e.clientX);
 if (!targetTimeline) return;
 
 const ws = workspaces.find(w => w.id === activeWorkspaceId);
 if (!ws) return;
 const proj = ws.projects.find(p => p.id === resizeState.projectId);
 if (!proj) return;
 
 const timelines = ws.timelines || [];
 const targetIndex = timelines.indexOf(targetTimeline);
 if (targetIndex === -1) return;
 
 let startIdx = timelines.indexOf(proj.timeline);
 let endIdx = timelines.indexOf(proj.timelineEnd || proj.timeline);
 
 if (resizeState.type === 'right') {
   // Right-drag resize (Extend or Contract from right edge)
   // Shortest constraint limit is 1 Quarter duration: targetIndex must be >= proj.timeline
   const currentStartIdx = timelines.indexOf(proj.timeline);
   if (targetIndex >= currentStartIdx) {
     endIdx = targetIndex;
     proj.timelineEnd = targetTimeline;
   }
 } else if (resizeState.type === 'left') {
   // Left-drag resize (Extend or Contract from left edge)
   // Shortest constraint limit is 1 Quarter duration: targetIndex must be <= proj.timelineEnd
   const currentEndIdx = timelines.indexOf(proj.timelineEnd || proj.timeline);
   if (targetIndex <= currentEndIdx) {
     startIdx = targetIndex;
     proj.timeline = targetTimeline;
   }
 }
 
 // Optimistic Inline style updates for smooth 60fps drag resizing
 const cardEl = document.getElementById(`card-${resizeState.projectId}`);
 if (cardEl) {
   cardEl.style.gridColumn = `${startIdx + 2} / ${endIdx + 3}`;
 }
 }

 function handleCardResizeMouseUp() {
 document.removeEventListener('mousemove', handleCardResizeMove);
 document.removeEventListener('mouseup', handleCardResizeMouseUp);
 
 document.body.style.userSelect = 'auto';
 document.body.style.cursor = 'default';
 
 // Re-enable pointer events on all cards
 const cards = document.querySelectorAll('.liquid-glass-card');
 cards.forEach(card => {
   card.style.pointerEvents = 'auto';
 });
 
 if (resizeState.projectId) {
   saveGlobalSnapshot();
   updateWorkspaceMetaCloud();
   const ws = workspaces.find(w => w.id === activeWorkspaceId);
   const proj = ws?.projects.find(p => p.id === resizeState.projectId);
   if (proj) {
     pushActivityLog(`Updated quarter duration range of card [${proj.title}] to [${proj.timeline} - ${proj.timelineEnd || proj.timeline}]`);
     if (selectedProjectId === resizeState.projectId) {
       showProjectDetails(selectedProjectId);
     }
   }
 }
 resizeState = { projectId: null, type: null, currentTower: null, initialTimeline: null, initialTimelineEnd: null };
 renderMatrices();
 }

 function initApp() {
 setupSearchInput();
 updateUndoRedoControls();
 
loadFromLocalStorageOrSeed();
 updateGlobalStats();
 
const sessionName = sessionStorage.getItem('collaborator_name');
 if (sessionName) {
 currentUserName = sessionName;
 document.getElementById('loginOverlay').style.display = 'none';
 
if (activeWorkspaceId) {
 applyActiveWorkspaceToUI();
 } else {
 renderHubView();
 }
 
startRealtimeSync();
 } else {
 document.getElementById('loginOverlay').style.display = 'flex';
 renderHubView();
 }
 }

 if (document.readyState === 'complete' || document.readyState === 'interactive') {
 initApp();
 } else {
 window.addEventListener('DOMContentLoaded', initApp);
 }
