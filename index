 function sortActiveTimelines() {
 const ws = workspaces.find(w => w.id === activeWorkspaceId);
 if (!ws) return;

 if (ws.manuallySorted) return;

 const quarterRegex = /^(\d*)Q([1-4])$/;
 let quarters = ws.timelines.filter(t => quarterRegex.test(t));
 let nonQuarters = ws.timelines.filter(t => !quarterRegex.test(t));
 
quarters.sort((a, b) => {
 const matchA = a.match(quarterRegex);
 const matchB = b.match(quarterRegex);
 
const yrA = matchA[1] ? parseInt(matchA[1], 10) : 0;
 const qtrA = parseInt(matchA[2], 10);
 const yrB = matchB[1] ? parseInt(matchB[1], 10) : 0;
 const qtrB = parseInt(matchB[2], 10);
 
if (yrA !== yrB) {
 return yrA - yrB;
 }
 return qtrA - qtrB;
 });
 
ws.timelines = [...quarters, ...nonQuarters];
 }

 function getNextQuarterCode() {
 const ws = workspaces.find(w => w.id === activeWorkspaceId);
 if (!ws) return 'Q2';

 const qs = ws.timelines.filter(t => t !== 'Pending' && t.match(/^(\d*)Q[1-4]$/));
 if (qs.length === 0) {
 return 'Q1';
 }
 
let maxYear = 0;
 let maxQ = 0;
 qs.forEach(q => {
 const m = q.match(/^(\d*)Q([1-4])$/);
 if (m) {
 const yr = m[1] ? parseInt(m[1], 10) : 0;
 const qtr = parseInt(m[2], 10);
 if (yr > maxYear || (yr === maxYear && qtr > maxQ)) {
 maxYear = yr;
 maxQ = qtr;
 }
 }
 });
 
let nextYear = maxYear;
 let nextQ = maxQ + 1;
 if (nextQ > 4) {
 nextQ = 1;
 nextYear = nextYear > 0 ? nextYear + 1 : 0;
 }
 return nextYear > 0 ? `${nextYear}Q${nextQ}` : `Q${nextQ}`;
 }

 function getTowerText(towerKey) {
 const ws = workspaces.find(w => w.id === activeWorkspaceId);
 if (!ws) return towerKey;
 return ws.towerNames[towerKey] || towerKey;
 }

