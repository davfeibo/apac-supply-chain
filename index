 case 'WIP':
 return { bg: 'bg-orange-50 text-orange-800 border-orange-200 hover:bg-orange-100/60', badge: 'bg-orange-500 text-white' };
 case 'Not started':
 return { bg: 'bg-sky-50 text-sky-800 border-sky-200 hover:bg-sky-100/60', badge: 'bg-sky-500 text-white' };
