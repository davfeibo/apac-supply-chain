 updateWorkspaceMetaCloud();
 pushActivityLog("Added a new subregion control lane.");
 showToast("New lane added successfully!");
 
applyActiveWorkspaceToUI();
 updateGlobalStats();
 }

 window.triggerAddQuarterDirectly = function() {
 const ws = workspaces.find(w => w.id === activeWorkspaceId);
 if (!ws) return;

 saveGlobalSnapshot();
 const nextCode = getNextQuarterCode();

 if (ws.timelines.includes(nextCode)) {
 showToast(`Quarter ${nextCode} already exists.`);
 return;
 }

 const pendingIdx = ws.timelines.indexOf('Pending');
 if (pendingIdx !== -1) {
 ws.timelines.splice(pendingIdx, 0, nextCode);
 } else {
 ws.timelines.push(nextCode);
 }

 updateWorkspaceMetaCloud();
 pushActivityLog(`Added a new timeline column: [${nextCode}]`);
 showToast(`Quarter column "${nextCode}" added.`);
 
applyActiveWorkspaceToUI();
 updateGlobalStats();
 }

