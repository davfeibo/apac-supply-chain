 const spanSize = oldEndIdx - oldStartIdx;

 proj.tower = tower;
 proj.timeline = time;

 const newStartIdx = ws.timelines.indexOf(time);
 let newEndIdx = newStartIdx + spanSize;
 if (newEndIdx >= ws.timelines.length) {
   newEndIdx = ws.timelines.length - 1;
 }
 proj.timelineEnd = ws.timelines[newEndIdx];

 updateWorkspaceMetaCloud();
 pushActivityLog(`Rescheduled [${proj.title}] from [${getTowerText(oldTower)} : ${oldTimeline}] to [${getTowerText(tower)} : ${time}]`);

