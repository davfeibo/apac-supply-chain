 async function startRealtimeSync() {
   if (!app || !auth || !db) {
     console.warn("Realtime sync unavailable: Services not initialized.");
     updateSyncStatusIndicator('local');
     return;
   }
   
   updateSyncStatusIndicator('saving');
   try {
     // Await Authentication FIRST (RULE 3 compliance)
     if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
       const credential = await signInWithCustomToken(auth, __initial_auth_token);
       user = credential.user;
     } else {
       const credential = await signInAnonymously(auth);
       user = credential.user;
     }

     if (!user) {
       updateSyncStatusIndicator('local');
       return;
     }

     // Auth successful, proceed to secure Firestore listener
     const docRef = getWorkspaceDocRef();
     if (!docRef) {
       updateSyncStatusIndicator('local');
       return;
     }

     onSnapshot(docRef, (snapshot) => {
       if (snapshot.exists()) {
         const data = snapshot.data();
         if (data.workspaces) {
           workspaces = data.workspaces;
         }
         if (data.activityLogs) {
           activityLogs = data.activityLogs;
           renderActivityLogs(activityLogs.slice(0, 15));
         }
         saveLocalState();

         workspaces.forEach(ws => {
           if (ws.projects) {
             ws.projects.forEach(p => {
               if (!p.timelineEnd) p.timelineEnd = p.timeline;
               if (p.status === 'On Going' || p.status === 'ongoing' || p.status === 'Ongoing' || p.status === 'Active') {
