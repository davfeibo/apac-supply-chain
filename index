 window.triggerAddTowerDirectly = function() {
 const ws = workspaces.find(w => w.id === activeWorkspaceId);
 if (!ws) return;

 saveGlobalSnapshot();
 const newKey = `tower-${Date.now()}`;
 ws.towers.push(newKey);
